# Generated pages — built from content/*.json by build.py.
# Not committed on purpose: the admin commits JSON only, so a committed copy
# of these would go stale the moment anyone edits content. Cloudflare Pages
# renders them at deploy time; run `python build.py` for a local copy.
/index.html
/music.html
/visuals.html
/about.html
/inthemaking.html
/zh/*.html
/dist/

# asset pipeline scratch (regenerate with tools/*.py)
/images/
/web/
ink_raw.png
ink_preview.png

# messages sent through the contact window while running tools/devserver.py
messages.local.jsonl

# The five web-encoded tracks the player streams are committed, so the
# deployed site actually has them. Masters, stems and work files are not:
# only .mp3 is un-ignored, and those stay local.
/audio/*
!/audio/README.md
!/audio/*.mp3

# OS / editor
Thumbs.db
desktop.ini
.DS_Store
.vscode/
__pycache__/
